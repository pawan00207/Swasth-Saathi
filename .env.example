# Prisma Postgres (all relational application data)
DATABASE_URL=

# Supabase Auth, private Storage, and Realtime Broadcast
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Government scheme catalogue (data.gov.in resource API)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=

# Accessible routing and traffic (server-side secrets)
OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Optional alternatives if the routing adapter is extended for these providers
TOMTOM_API_KEY=
MAPPLS_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Verified hospital management system feed (optional)
HOSPITAL_BED_API_URL=
HOSPITAL_BED_API_KEY=

# Private Jitsi as a Service room access (optional; do not use public Jitsi for PHI)
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=

# Razorpay TEST mode (payment API integration is provider-dependent)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing AI and DHRS adapters
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DHRS_API_URL=http://localhost:5000
DHRS_API_KEY=
FABRIC_ANCHOR_ENABLED=true
